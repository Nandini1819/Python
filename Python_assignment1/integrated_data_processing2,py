from functools import reduce
numbers = [-2,1,2,3,4,6,-8]
filtered = filter(lambda x: x>=0 and x%2==0,numbers)
squared = list(map(lambda x: x*x,filtered))
total = reduce(lambda x,y: x+y, squared,0)
count = len(squared)
largest = reduce(lambda x,y:x if x>y else y, squared)
print("Total:",total)
print("Count:",count)
print("Largest Squared value:",largest)